{
  "manifest_version": 3,
  "name": "Opened Link Highlighter",
  "version": "2.0",
  "description": "Highlights all links opened on any tab while enabled.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "css": ["highlight.css"]
    }
  ],
  "icons": {
    "128": "icons/icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "109.0",
      "id": "{93070e97-cab0-454a-bdf1-df682dbe42f6}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
